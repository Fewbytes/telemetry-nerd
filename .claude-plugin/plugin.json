{
  "name": "telemetry-nerd",
  "version": "0.1.0",
  "description": "Evidence-first telemetry analysis workspace for Claude",
  "license": "Apache-2.0",
  "author": {
    "name": "Avishai Ish-Shalom"
  },
  "homepage": "https://github.com/Fewbytes/telemetry-nerd",
  "repository": "https://github.com/Fewbytes/telemetry-nerd",
  "icon": "./assets/brand/dist/icon-512.png",
  "keywords": [
    "telemetry",
    "observability",
    "metrics",
    "prometheus",
    "victoriametrics",
    "mcp",
    "analysis"
  ],
  "mcpServers": {
    "telemetry-nerd": {
      "command": "sh",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/tn-launch",
        "bridge"
      ],
      "env": {
        "TN_SOURCE_URL": "${TN_SOURCE_URL:-http://127.0.0.1:8428}"
      }
    }
  }
}
